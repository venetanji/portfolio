---
// Friendly Polygons — vanilla Canvas port of
// https://observablehq.com/@venetanji/friendly-poligons
//
// Faithful to the original math: every polygon in a ring shares the same
// `sides` and `scale`, both driven by ONE simplex sample noise2D(t/1000, 1).
// scale can go negative (mirroring). Hue per polygon, position around a
// circle. This is what makes the polygons "breathe" together.
//
// Optional embellishment: `rings > 1` stacks concentric copies offset in
// time so they cascade.
interface Props {
  /** Number of polygons in each ring. Original used `num_poly` slider. */
  count?: number;
  /** Concentric rings. 1 = faithful to the original. */
  rings?: number;
  /** Stroke alpha multiplier. */
  intensity?: number;
  /** Animation speed, multiplier on internal time. */
  speed?: number;
  /** Apply additive blending for a glow look. */
  glow?: boolean;
  class?: string;
}
const {
  count = 20,
  rings = 1,
  intensity = 1,
  speed = 1,
  glow = true,
  class: className = "",
} = Astro.props;
---

<canvas
  class:list={["polygon-field", className]}
  data-count={count}
  data-rings={rings}
  data-intensity={intensity}
  data-speed={speed}
  data-glow={glow ? "1" : "0"}
></canvas>

<style>
  .polygon-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }
</style>

<script>
  import { createNoise2D } from "simplex-noise";

  type FieldEl = HTMLCanvasElement & { __polyFieldInit?: boolean };

  const TAU = Math.PI * 2;

  function setup(canvas: FieldEl) {
    if (canvas.__polyFieldInit) return;
    canvas.__polyFieldInit = true;

    const ctx = canvas.getContext("2d", { alpha: true });
    if (!ctx) return;

    const count = Number(canvas.dataset.count ?? 20);
    const rings = Number(canvas.dataset.rings ?? 1);
    const intensity = Number(canvas.dataset.intensity ?? 1);
    const speed = Number(canvas.dataset.speed ?? 1);
    const glow = canvas.dataset.glow === "1";

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const noise = createNoise2D();

    let dpr = Math.min(window.devicePixelRatio || 1, 2);
    let width = 0;
    let height = 0;

    function resize() {
      const rect = canvas.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = rect.width;
      height = rect.height;
      canvas.width = Math.max(1, Math.floor(width * dpr));
      canvas.height = Math.max(1, Math.floor(height * dpr));
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    resize();
    new ResizeObserver(resize).observe(canvas);

    let visible = true;
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(canvas);

    function polygon(cx: number, cy: number, scale: number, sides: number) {
      // Faithful to original: points start at angle 0, no rotation offset.
      const s = Math.max(3, Math.floor(sides));
      ctx!.beginPath();
      for (let i = 0; i <= s; i++) {
        const a = (TAU * i) / s;
        const x = cx + Math.cos(a) * scale;
        const y = cy + Math.sin(a) * scale;
        if (i === 0) ctx!.moveTo(x, y);
        else ctx!.lineTo(x, y);
      }
      ctx!.stroke();
    }

    let t = 0;
    let lastFrame = performance.now();

    function frame(now: number) {
      if (!document.body.contains(canvas)) return;

      const dt = Math.min(64, now - lastFrame);
      lastFrame = now;

      if (visible) {
        // The original uses `slow_iterator` which increments every 50ms.
        // We track an equivalent in the same units so the noise scaling matches.
        t += (dt / 50) * speed;

        ctx!.globalCompositeOperation = "source-over";
        ctx!.fillStyle = "rgba(8, 9, 14, 0.16)";
        ctx!.fillRect(0, 0, width, height);

        if (glow) ctx!.globalCompositeOperation = "lighter";

        // Frame the ring inside the viewport. Original was 100px radius
        // around (300, 200) on a 500-wide svg → ~20% of width.
        const cx = width * 0.5;
        const cy = height * 0.5;
        const ringRadius = Math.min(width, height) * 0.22;
        const baseScale = Math.min(width, height) * 0.5;

        ctx!.lineWidth = 1.4;

        for (let r = 0; r < rings; r++) {
          // For multi-ring mode, offset each ring in time so they breathe out of phase.
          const tr = t + r * 80;

          // SHARED across the whole ring — this is the key insight.
          const sample = noise(tr / 1000, 1);
          const sides = sample * 7 + 6;          // [-1, 13] → clamped to ≥3 inside polygon()
          const scale = baseScale * sample;       // can be negative (mirrors), looks great

          for (let d = 0; d < count; d++) {
            const px = cx + Math.cos((TAU * d) / count) * ringRadius;
            const py = cy + Math.sin((TAU * d) / count) * ringRadius;

            // Original: h = slow_iterator + d*20/255 (visually wraps modulo 360).
            const hue = (tr + d * (360 / count)) % 360;
            const sat = 60 + Math.abs(noise(d * 0.2, r)) * 30;
            const lit = 55 + (rings > 1 ? r * 4 : 0);
            const alpha = intensity * (rings > 1 ? 0.4 + 0.6 * (1 - r / rings) : 0.85);

            ctx!.strokeStyle = `hsla(${hue.toFixed(1)}, ${sat.toFixed(0)}%, ${lit.toFixed(0)}%, ${alpha.toFixed(3)})`;
            polygon(px, py, scale, sides);
          }
        }
      }

      if (!reduced) requestAnimationFrame(frame);
    }

    if (reduced) frame(performance.now());
    else requestAnimationFrame(frame);
  }

  function init() {
    document.querySelectorAll<FieldEl>("canvas.polygon-field").forEach(setup);
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
