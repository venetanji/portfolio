---
interface Props { count?: number; rings?: number; intensity?: number; speed?: number; glow?: boolean; class?: string; }
const { count = 20, rings = 1, intensity = 1, speed = 1, class: className = "" } = Astro.props;
---
<canvas class:list={["polygon-field", className]} data-count={count} data-rings={rings} data-intensity={intensity} data-speed={speed}></canvas>
<style>.polygon-field { position: absolute; inset: 0; width: 100%; height: 100%; display: block; pointer-events: none; }</style>
<script>
  import { createNoise2D } from "simplex-noise";
  type FieldEl = HTMLCanvasElement & { __polyFieldInit?: boolean };
  const TAU = Math.PI * 2;
  function setup(canvas: FieldEl) {
    if (canvas.__polyFieldInit) return;
    canvas.__polyFieldInit = true;
    const ctx = canvas.getContext("2d", { alpha: true });
    if (!ctx) return;
    const count = Number(canvas.dataset.count ?? 20);
    const rings = Number(canvas.dataset.rings ?? 1);
    const intensity = Number(canvas.dataset.intensity ?? 1);
    const speed = Number(canvas.dataset.speed ?? 1);
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const noise = createNoise2D();
    let dpr = Math.min(window.devicePixelRatio || 1, 2), width = 0, height = 0;
    function resize() {
      const r = canvas.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = r.width; height = r.height;
      canvas.width = Math.max(1, Math.floor(width * dpr));
      canvas.height = Math.max(1, Math.floor(height * dpr));
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    resize();
    new ResizeObserver(resize).observe(canvas);
    let visible = true;
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(canvas);
    function polygon(cx: number, cy: number, scale: number, sides: number) {
      const n = Math.ceil(sides);
      if (n < 3) return;
      ctx!.beginPath();
      for (let i = 0; i < n; i++) {
        const a = (TAU * i) / sides;
        const x = cx + Math.cos(a) * scale;
        const y = cy + Math.sin(a) * scale;
        if (i === 0) ctx!.moveTo(x, y);
        else ctx!.lineTo(x, y);
      }
      ctx!.closePath();
      ctx!.stroke();
    }
    let t = 0, lastFrame = performance.now();
    function frame(now: number) {
      if (!document.body.contains(canvas)) return;
      const dt = Math.min(64, now - lastFrame);
      lastFrame = now;
      if (visible) {
        t += (dt / 50) * speed;
        ctx!.globalCompositeOperation = "source-over";
        ctx!.fillStyle = "rgba(0, 0, 0, 0.08)";
        ctx!.fillRect(0, 0, width, height);
        const cx = width * 0.5, cy = height * 0.5;
        const ringRadius = Math.min(width, height) * 0.22;
        const baseScale = Math.min(width, height) * 0.42;
        ctx!.lineWidth = 0.8;
        for (let r = 0; r < rings; r++) {
          const tr = t + r * 80;
          const sample = noise(tr / 1000, 1);
          const sides = sample * 7 + 6;
          const scale = baseScale * sample;
          for (let d = 0; d < count; d++) {
            const px = cx + Math.cos((TAU * d) / count) * ringRadius;
            const py = cy + Math.sin((TAU * d) / count) * ringRadius;
            ctx!.strokeStyle = `rgba(255, 255, 255, ${(0.65 * intensity).toFixed(3)})`;
            polygon(px, py, scale, sides);
          }
        }
      }
      if (!reduced) requestAnimationFrame(frame);
    }
    if (reduced) frame(performance.now());
    else requestAnimationFrame(frame);
  }
  function init() { document.querySelectorAll<FieldEl>("canvas.polygon-field").forEach(setup); }
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", init);
  else init();
</script>
