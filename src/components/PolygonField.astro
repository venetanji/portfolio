---
// Friendly Polygons — vanilla Canvas port of
// https://observablehq.com/@venetanji/friendly-poligons
// Concentric polygons morph through simplex noise, hue cycles around the wheel.
interface Props {
  /** Number of polygons in each ring. */
  count?: number;
  /** Number of rings, drawn from large (background) to small (foreground). */
  rings?: number;
  /** Base alpha multiplier for strokes. */
  intensity?: number;
  /** Animation speed, multiplier on internal time. */
  speed?: number;
  /** Apply a soft additive blend mode for a glow look. */
  glow?: boolean;
  class?: string;
}
const {
  count = 14,
  rings = 3,
  intensity = 0.55,
  speed = 1,
  glow = true,
  class: className = "",
} = Astro.props;
---

<canvas
  class:list={["polygon-field", className]}
  data-count={count}
  data-rings={rings}
  data-intensity={intensity}
  data-speed={speed}
  data-glow={glow ? "1" : "0"}
></canvas>

<style>
  .polygon-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }
</style>

<script>
  import { createNoise2D } from "simplex-noise";

  type FieldEl = HTMLCanvasElement & { __polyFieldInit?: boolean };

  const TAU = Math.PI * 2;

  function setup(canvas: FieldEl) {
    if (canvas.__polyFieldInit) return;
    canvas.__polyFieldInit = true;

    const ctx = canvas.getContext("2d", { alpha: true });
    if (!ctx) return;

    const count = Number(canvas.dataset.count ?? 14);
    const rings = Number(canvas.dataset.rings ?? 3);
    const intensity = Number(canvas.dataset.intensity ?? 0.55);
    const speed = Number(canvas.dataset.speed ?? 1);
    const glow = canvas.dataset.glow === "1";

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // One noise field per dimension we drive (sides, scale, hue jitter).
    const noiseSides = createNoise2D();
    const noiseScale = createNoise2D();
    const noiseHue = createNoise2D();

    let dpr = Math.min(window.devicePixelRatio || 1, 2);
    let width = 0;
    let height = 0;

    function resize() {
      const rect = canvas.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = rect.width;
      height = rect.height;
      canvas.width = Math.max(1, Math.floor(width * dpr));
      canvas.height = Math.max(1, Math.floor(height * dpr));
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    resize();

    let pointer = { x: 0, y: 0, active: false };
    canvas.parentElement?.addEventListener("pointermove", (e) => {
      const rect = canvas.getBoundingClientRect();
      pointer.x = (e.clientX - rect.left) / rect.width - 0.5;
      pointer.y = (e.clientY - rect.top) / rect.height - 0.5;
      pointer.active = true;
    });
    canvas.parentElement?.addEventListener("pointerleave", () => {
      pointer.active = false;
    });

    let visible = true;
    const io = new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
      },
      { threshold: 0 }
    );
    io.observe(canvas);

    const ro = new ResizeObserver(resize);
    ro.observe(canvas);

    function polygon(cx: number, cy: number, r: number, sides: number, rotation: number) {
      const s = Math.max(3, Math.floor(sides));
      ctx!.beginPath();
      for (let i = 0; i <= s; i++) {
        const a = rotation + (TAU * i) / s;
        const x = cx + Math.cos(a) * r;
        const y = cy + Math.sin(a) * r;
        if (i === 0) ctx!.moveTo(x, y);
        else ctx!.lineTo(x, y);
      }
      ctx!.stroke();
    }

    let t = 0;
    let lastFrame = performance.now();

    function frame(now: number) {
      if (!document.body.contains(canvas)) {
        io.disconnect();
        ro.disconnect();
        return;
      }

      const dt = Math.min(64, now - lastFrame);
      lastFrame = now;

      if (visible) {
        t += dt * 0.06 * speed;

        ctx!.globalCompositeOperation = "source-over";
        // Trail: clear with low-opacity rect for a smooth fade rather than a hard wipe.
        ctx!.fillStyle = "rgba(8, 9, 14, 0.14)";
        ctx!.fillRect(0, 0, width, height);

        if (glow) ctx!.globalCompositeOperation = "lighter";

        const cx = width * 0.5 + (pointer.active ? pointer.x * width * 0.08 : 0);
        const cy = height * 0.5 + (pointer.active ? pointer.y * height * 0.08 : 0);
        const baseRadius = Math.min(width, height) * 0.18;

        ctx!.lineWidth = 1.1;

        for (let r = 0; r < rings; r++) {
          const ringPhase = r * 0.37;
          const ringRadius = baseRadius * (1 + r * 1.05);

          for (let d = 0; d < count; d++) {
            const angle = (TAU * d) / count + t * 0.0015 * (r % 2 === 0 ? 1 : -1);

            const px = cx + Math.cos(angle) * ringRadius;
            const py = cy + Math.sin(angle) * ringRadius;

            const sides =
              noiseSides(t / 1000 + ringPhase, d * 0.21) * 7 + 6;

            const scale =
              ringRadius *
              0.55 *
              (0.6 +
                noiseScale(t / 1200 + ringPhase, d * 0.13 + r) * 0.55);

            const hue =
              (t * 0.4 + d * (360 / count) + r * 35 +
                noiseHue(d * 0.5, r + t / 2000) * 40) %
              360;
            const sat = 70 + noiseHue(d, r) * 20;
            const lit = 55 + r * 4;
            const alpha = intensity * (0.35 + 0.65 * (1 - r / rings));

            ctx!.strokeStyle = `hsla(${hue.toFixed(1)}, ${sat.toFixed(0)}%, ${lit.toFixed(0)}%, ${alpha.toFixed(3)})`;
            polygon(px, py, scale, sides, t * 0.0009 + d);
          }
        }
      }

      if (!reduced) requestAnimationFrame(frame);
    }

    if (reduced) {
      // Render a single static frame and stop.
      frame(performance.now());
    } else {
      requestAnimationFrame(frame);
    }
  }

  function init() {
    document
      .querySelectorAll<FieldEl>("canvas.polygon-field")
      .forEach(setup);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
