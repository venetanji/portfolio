---
// "Nake" — port of https://editor.p5js.org/venetanji/sketches/bQCUFuXc_s
// 50×50 generative grid: per-cell verticals weighted by anti-diagonal distance,
// horizontals only below empty cells. Click to reseed.
interface Props {
  seed?: number;
  grid?: number;
  border?: number;
  hprob?: number;
  class?: string;
}
const {
  seed = 45,
  grid = 50,
  border = 3,
  hprob = 0.4,
  class: className = "",
} = Astro.props;
---

<div class:list={["nake-wrap", className]}>
  <canvas
    class="nake"
    data-seed={seed}
    data-grid={grid}
    data-border={border}
    data-hprob={hprob}
  ></canvas>
  <button class="reseed" type="button" aria-label="New seed">↻</button>
</div>

<style>
  .nake-wrap {
    position: relative;
    aspect-ratio: 1 / 1;
    background: #0A0E14;
    border: 1px solid var(--rule);
    overflow: hidden;
  }
  .nake {
    width: 100%;
    height: 100%;
    display: block;
  }
  .reseed {
    position: absolute;
    top: .8rem;
    right: .8rem;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    border: 1px solid var(--rule-strong);
    background: rgba(17, 21, 28, 0.85);
    color: var(--accent);
    font-size: 1.1rem;
    cursor: pointer;
    backdrop-filter: blur(4px);
    transition: transform 200ms, background 200ms, color 200ms;
  }
  .reseed:hover {
    transform: rotate(90deg);
    background: rgba(17, 21, 28, 1);
    color: var(--accent-2);
  }
</style>

<script>
  type NakeEl = HTMLCanvasElement & { __nakeInit?: boolean };

  // Mulberry32 — small, deterministic PRNG.
  function mulberry32(seed: number) {
    let s = seed >>> 0;
    return function () {
      s = (s + 0x6d2b79f5) >>> 0;
      let t = s;
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  function setup(canvas: NakeEl) {
    if (canvas.__nakeInit) return;
    canvas.__nakeInit = true;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const grid = Number(canvas.dataset.grid ?? 50);
    const borderN = Number(canvas.dataset.border ?? 3);
    const hprob = Number(canvas.dataset.hprob ?? 0.4);
    let seed = Number(canvas.dataset.seed ?? 45);

    function render() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const rect = canvas.getBoundingClientRect();
      const size = Math.max(1, Math.floor(Math.min(rect.width, rect.height)));
      canvas.width = size * dpr;
      canvas.height = size * dpr;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      const gsize = size / grid;
      const rand = mulberry32(seed);

      ctx!.fillStyle = "#0A0E14";
      ctx!.fillRect(0, 0, size, size);
      ctx!.strokeStyle = "#A0A4AA";
      ctx!.lineWidth = 1.6;
      ctx!.lineCap = "square";

      let ps = false;
      for (let x = 0; x < grid; x++) {
        for (let y = 0; y < grid; y++) {
          const borderx = x < borderN || x > grid - borderN;
          const bordery = y < borderN || y > grid - borderN - 1;
          if (borderx || bordery) {
            ps = false;
            continue;
          }

          const cx = x * gsize;
          const cy = y * gsize;

          const drawVertical = rand() > Math.abs(x - y) / grid;
          const skipFirst = y > borderN;
          const skipLast = x < grid - borderN - 1;
          const p = rand() < hprob;
          const drawHorizontal = skipFirst && skipLast && ps && p;

          ps = true;

          ctx!.beginPath();
          if (drawVertical) {
            ctx!.moveTo(cx, cy);
            ctx!.lineTo(cx, cy + gsize);
            ps = false;
          }
          if (drawHorizontal) {
            ctx!.moveTo(cx, cy);
            ctx!.lineTo(cx + gsize, cy);
            ps = false;
          }
          ctx!.stroke();
        }
      }
    }

    render();
    new ResizeObserver(render).observe(canvas);

    const wrap = canvas.parentElement;
    wrap?.querySelector(".reseed")?.addEventListener("click", () => {
      seed = Math.floor(Math.random() * 1e9);
      render();
    });
    canvas.addEventListener("click", () => {
      seed = Math.floor(Math.random() * 1e9);
      render();
    });
  }

  function init() {
    document.querySelectorAll<NakeEl>("canvas.nake").forEach(setup);
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
