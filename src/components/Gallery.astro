---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  images: ImageMetadata[];
  alt?: string;
}

const { images, alt = "Gallery image" } = Astro.props;
---

{images.length > 0 && (
  <section class="gallery" aria-label="Project gallery">
    <ul>
      {images.map((img, i) => (
        <li style={`grid-row: span ${img.height > img.width ? 2 : 1};`}>
          <button type="button" class="gallery-tile" data-index={i}>
            <Image
              src={img}
              alt={`${alt} ${i + 1}`}
              widths={[480, 800, 1200]}
              sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw"
              loading="lazy"
            />
          </button>
        </li>
      ))}
    </ul>
  </section>

  <dialog class="gallery-lightbox">
    <button type="button" class="gl-close" aria-label="Close">×</button>
    <button type="button" class="gl-prev" aria-label="Previous">‹</button>
    <button type="button" class="gl-next" aria-label="Next">›</button>
    <div class="gl-frame">
      {images.map((img, i) => (
        <Image
          src={img}
          alt={`${alt} ${i + 1}`}
          widths={[1200, 1800]}
          sizes="100vw"
          data-index={i}
          loading="lazy"
        />
      ))}
    </div>
  </dialog>
)}

<style>
  .gallery {
    width: var(--w);
    margin-inline: auto;
    margin-block: 4rem;
  }
  .gallery ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 200px;
    gap: 4px;
  }
  @media (max-width: 700px) {
    .gallery ul {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 160px;
    }
  }
  .gallery-tile {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: var(--bg-elev);
    cursor: zoom-in;
    overflow: hidden;
  }
  .gallery-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.2, 0.8, 0.2, 1),
      filter 400ms ease;
    filter: saturate(0.85);
  }
  .gallery-tile:hover img {
    transform: scale(1.04);
    filter: saturate(1);
  }

  .gallery-lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(8, 9, 14, 0.96);
    color: var(--fg);
  }
  .gallery-lightbox::backdrop {
    background: rgba(8, 9, 14, 0.96);
  }
  .gl-frame {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 5rem 4rem;
  }
  .gl-frame img {
    display: none;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .gl-frame img.is-active {
    display: block;
  }
  .gl-close,
  .gl-prev,
  .gl-next {
    position: absolute;
    background: transparent;
    border: 0;
    color: var(--fg);
    font-size: 2.5rem;
    cursor: pointer;
    width: 3.5rem;
    height: 3.5rem;
    display: grid;
    place-items: center;
    transition: color 200ms;
  }
  .gl-close:hover,
  .gl-prev:hover,
  .gl-next:hover { color: var(--accent); }
  .gl-close { top: .5rem; right: .5rem; font-size: 2rem; }
  .gl-prev { top: 50%; left: .5rem; transform: translateY(-50%); }
  .gl-next { top: 50%; right: .5rem; transform: translateY(-50%); }
</style>

<script>
  function setupGallery() {
    const lightbox = document.querySelector<HTMLDialogElement>(".gallery-lightbox");
    if (!lightbox) return;

    const slides = Array.from(
      lightbox.querySelectorAll<HTMLImageElement>(".gl-frame img")
    );
    if (slides.length === 0) return;

    let current = 0;

    function show(i: number) {
      current = (i + slides.length) % slides.length;
      slides.forEach((s, idx) => s.classList.toggle("is-active", idx === current));
    }

    document.querySelectorAll<HTMLButtonElement>(".gallery-tile").forEach((tile) => {
      tile.addEventListener("click", () => {
        const i = Number(tile.dataset.index ?? 0);
        show(i);
        lightbox.showModal();
      });
    });

    lightbox.querySelector(".gl-close")?.addEventListener("click", () => lightbox.close());
    lightbox.querySelector(".gl-prev")?.addEventListener("click", () => show(current - 1));
    lightbox.querySelector(".gl-next")?.addEventListener("click", () => show(current + 1));

    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox) lightbox.close();
    });
    document.addEventListener("keydown", (e) => {
      if (!lightbox.open) return;
      if (e.key === "ArrowLeft") show(current - 1);
      if (e.key === "ArrowRight") show(current + 1);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupGallery);
  } else {
    setupGallery();
  }
</script>
