---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import { authorList, getPublicationImage, getYear } from "@/lib/format";

export async function getStaticPaths() {
  const pubs = await getCollection("publications", ({ data }) => !data.draft);
  return pubs.map((p) => ({ params: { slug: p.id }, props: { pub: p } }));
}

const { pub } = Astro.props;
const { Content } = await render(pub);
const img = getPublicationImage(pub.id);
const hasContent = pub.body && pub.body.trim().length > 0;
---

<Base title={pub.data.title} description={pub.data.publication}>
  <article class="single">
    <header>
      <a href="/#publications" class="back">← Writing</a>
      <p class="kicker" style="margin-top:1.5rem">{getYear(pub.data.date)}</p>
      <h1>{pub.data.title}</h1>
      <p class="lede" style="color:var(--fg-mute)">{authorList(pub.data.authors)}</p>
      {pub.data.publication && (
        <p class="kicker" style="margin-top:1rem">In <em>{pub.data.publication}</em></p>
      )}

      <div class="pub-links" style="margin-top:1.5rem">
        {pub.data.url_pdf && <a href={pub.data.url_pdf} target="_blank" rel="noopener">PDF</a>}
        {pub.data.doi && <a href={`https://doi.org/${pub.data.doi}`} target="_blank" rel="noopener">DOI</a>}
      </div>
    </header>

    {img && (
      <div class="hero-img">
        <Image src={img} alt={pub.data.title} widths={[800, 1200, 1800]} sizes="(max-width: 1200px) 100vw, 1200px" />
      </div>
    )}

    {hasContent && (
      <div class="prose">
        <Content />
      </div>
    )}

    {pub.data.abstract && !hasContent && (
      <div class="prose">
        <h2>Abstract</h2>
        <p>{pub.data.abstract}</p>
      </div>
    )}
  </article>
</Base>
